# FinQuery Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Environment Mode: development / production / testing
ENVIRONMENT=development

# Gemini LLM Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/finquery.db

# RAG Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_INDEX_DIR=./data/vector_store
DOCUMENTS_DIR=./documents/financial_knowledge
CHUNK_SIZE=350
CHUNK_OVERLAP=50
RAG_TOP_K=3

# Frontend Configuration
API_BASE_URL=http://localhost:8000
